  "components": {
    "schemas": {
      "Body_create_task_api_v1_tasks_post": {
        "properties": {
          "report_type": {
            "$ref": "#/components/schemas/ReportType"
          },
          "period": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Period"
          },
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "report_type",
          "period",
          "files"
        ],
        "title": "Body_create_task_api_v1_tasks_post"
      },
      "Conflict": {
        "properties": {
          "conflict_id": {
            "type": "string",
            "pattern": "^conflict_[A-Za-z0-9._-]+$",
            "title": "Conflict Id"
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description"
          },
          "fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fact Ids"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 2,
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conflict_id",
          "description",
          "evidence_ids"
        ],
        "title": "Conflict"
      },
      "DecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "edit",
              "reject"
            ],
            "title": "Decision"
          },
          "edited_markdown": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Markdown"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionRequest"
      },
      "EvaluationRequest": {
        "properties": {
          "split": {
            "type": "string",
            "enum": [
              "dev",
              "test",
              "all"
            ],
            "title": "Split"
          },
          "system": {
            "type": "string",
            "enum": [
              "baseline",
              "workpilot_single",
              "workpilot_heterogeneous",
              "challenger",
              "both",
              "all_systems",
              "dev_matrix",
              "test_matrix"
            ],
            "title": "System"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "split",
          "system"
        ],
        "title": "EvaluationRequest"
      },
      "Evidence": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{16}$",
            "title": "Evidence Id"
          },
          "material_id": {
            "type": "string",
            "pattern": "^mat_[0-9a-f]{16}$",
            "title": "Material Id"
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "title": "Source Path"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "title": "Locator"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Excerpt"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "material_id",
          "source_path",
          "locator",
          "excerpt",
          "sha256"
        ],
        "title": "Evidence"
      },
      "Fact": {
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^fact_[A-Za-z0-9._-]+$",
            "title": "Fact Id"
          },
          "statement": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Statement"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Category",
            "default": "achievement"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "status": {
            "$ref": "#/components/schemas/FactStatus",
            "default": "supported"
          },
          "period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "predicate": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicate"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fact_id",
          "statement",
          "evidence_ids"
        ],
        "title": "Fact"
      },
      "FactStatus": {
        "type": "string",
        "enum": [
          "supported",
          "conflicted",
          "unsupported"
        ],
        "title": "FactStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportedPackage": {
        "properties": {
          "materials": {
            "items": {
              "$ref": "#/components/schemas/Material"
            },
            "type": "array",
            "minItems": 1,
            "title": "Materials"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "materials",
          "evidence"
        ],
        "title": "ImportedPackage"
      },
      "Material": {
        "properties": {
          "material_id": {
            "type": "string",
            "pattern": "^mat_[0-9a-f]{16}$",
            "title": "Material Id"
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "title": "Source Path"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "markdown",
              "text",
              "csv"
            ],
            "title": "Media Type"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size Bytes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "material_id",
          "source_path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "title": "Material"
      },
      "ReportBundle": {
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ReportMetadata"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "type": "array",
            "title": "Facts"
          },
          "conflicts": {
            "items": {
              "$ref": "#/components/schemas/Conflict"
            },
            "type": "array",
            "title": "Conflicts"
          },
          "risks": {
