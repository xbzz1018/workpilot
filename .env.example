# Never commit real keys or external endpoints. Configure both locally in the ignored .env.
WORKPILOT_BASE_URL=
WORKPILOT_MAIN_API_KEY=
WORKPILOT_EXTRACTOR_API_KEY=
WORKPILOT_VERIFIER_API_KEY=
WORKPILOT_CHALLENGER_API_KEY=

# Set model IDs only in the ignored local .env after confirming them with the configured Provider.
WORKPILOT_MAIN_MODEL=provider-main-model
WORKPILOT_EXTRACTOR_MODEL=provider-extractor-model
WORKPILOT_VERIFIER_MODEL=provider-verifier-model
WORKPILOT_BASELINE_MODEL=provider-baseline-model
WORKPILOT_CHALLENGER_MODEL=provider-challenger-model

WORKPILOT_WORKSPACE=workspace
WORKPILOT_TASK_DB=workspace/workpilot.sqlite
WORKPILOT_RETENTION_DAYS=30
WORKPILOT_MAX_ACTIVE_TASKS=3

# Local private deployment. Use a real domain later to enable automatic HTTPS.
WORKPILOT_DOMAIN=http://localhost
WORKPILOT_ADMIN_USER=admin
WORKPILOT_ADMIN_HASH=
WORKPILOT_ADMIN_PASSWORD=
